# Desarrollo local. Cambia la clave antes de usar otra instalación.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-development-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite es el motor por defecto. Para PostgreSQL, usa DB_ENGINE=django.db.backends.postgresql.
DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=uml_collaborative_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# IA local: inicia el servidor de LM Studio en el puerto indicado.
# Consulta GET http://localhost:1235/v1/models para copiar los identificadores exactos.
# Ollama: cambia LLM_BASE_URL a http://localhost:11434/v1 y ajusta los modelos.
LLM_BASE_URL=http://localhost:1235/v1
LLM_TEXT_MODEL=qwen2.5-3b-instruct
LLM_VISION_MODEL=qwen2.5-vl-3b-instruct
LLM_API_KEY=lm-studio
LLM_TIMEOUT=180
LLM_VISION_TIMEOUT=300
