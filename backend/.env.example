# Desarrollo local. Cambia la clave antes de usar otra instalación.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-development-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite es el motor por defecto. Para PostgreSQL, usa DB_ENGINE=django.db.backends.postgresql.
DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=uml_collaborative_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Opcional: funciones de IA de Gemini.
GEMINI_API_KEY=
