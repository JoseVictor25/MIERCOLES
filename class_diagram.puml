@startuml Modelo_de_datos_UMLCraft
title Modelos persistidos actuales

class User {
  +id: bigint
  +username: string
  +email: string (único)
  +avatar: imagen opcional
  +created_at: datetime
  .. otros campos de AbstractUser ..
}

class Project {
  +id: bigint
  +name: string
  +description: text
  +datos_diagrama: JSON
  +created_at: datetime
  +updated_at: datetime
}

class ProjectCollaborator {
  +id: bigint
  +role: editor | viewer
  +joined_at: datetime
}

class DiagramSnapshot {
  +id: bigint
  +diagram_data: JSON
  +label: string
  +created_at: datetime
}

User "1" -- "0..*" Project : owner
User "1" -- "0..*" ProjectCollaborator : user
Project "1" -- "0..*" ProjectCollaborator : project
User "0..1" -- "0..*" DiagramSnapshot : saved_by
Project "1" -- "0..*" DiagramSnapshot : project

note right of Project
  datos_diagrama contiene nodes y edges.
end note
@enduml
